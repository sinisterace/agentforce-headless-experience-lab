<?xml version="1.0" encoding="UTF-8"?>
<!-- Live data: call invocable Apex EcwCase360 to build the case prep snapshot
     from the running user's most pressing open case, then assign it to the DTO
     output. `Details` ignored. -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <actionCalls>
        <name>Get_Case_360</name>
        <label>Get Case 360</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <actionName>EcwCase360</actionName>
        <actionType>apex</actionType>
        <connector><targetReference>Assign_To_Options</targetReference></connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>details</name>
            <value><elementReference>Details</elementReference></value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <assignments>
        <name>Assign_To_Options</name>
