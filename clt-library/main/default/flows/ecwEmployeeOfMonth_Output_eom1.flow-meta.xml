<?xml version="1.0" encoding="UTF-8"?>
<!-- Call invocable Apex EcwEmployeeOfMonth to build the (static, gag) card
     payload, then assign it to the DTO output. The LLM-provided `Details` is
     ignored (kept only to satisfy the action signature). -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <actionCalls>
        <name>Get_Employee_Of_Month</name>
        <label>Get Employee Of Month</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <actionName>EcwEmployeeOfMonth</actionName>
        <actionType>apex</actionType>
        <connector><targetReference>Assign_To_Options</targetReference></connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>details</name>
            <value><elementReference>Details</elementReference></value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <assignments>
        <name>Assign_To_Options</name>
        <label>Assign To Options</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>Options.ecwEmployeeOfMonthJSON</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_Employee_Of_Month.json</elementReference></value>
        </assignmentItems>
    </assignments>
    <description>Show the Employee of the Month card (Lauren Bailey, Chief Demo Officer) — a celebratory demo gag with Congratulate / Nominate actions.</description>
    <environments>Default</environments>
    <interviewLabel>Ecw Employee Of Month {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Agentforce Coworker · Employee of the Month</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector><targetReference>Get_Employee_Of_Month</targetReference></connector>
    </start>
    <status>Active</status>
    <variables>
        <description>LLM-provided payload (ignored; data comes from Apex).</description>
        <name>Details</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Show to the user</description>
        <name>Options</name>
        <apexClass>EcwEmployeeOfMonthData</apexClass>
        <dataType>Apex</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
