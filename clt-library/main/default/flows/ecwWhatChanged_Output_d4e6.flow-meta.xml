<?xml version="1.0" encoding="UTF-8"?>
<!-- Call invocable Apex EcwWhatChanged to build the recent deal-motion feed,
     then assign it to the DTO output. The LLM-provided `Details` is ignored. -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <actionCalls>
        <name>Get_What_Changed</name>
        <label>Get What Changed</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <actionName>EcwWhatChanged</actionName>
        <actionType>apex</actionType>
        <connector><targetReference>Assign_To_Options</targetReference></connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>details</name>
            <value><elementReference>Details</elementReference></value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <assignments>
        <name>Assign_To_Options</name>
        <label>Assign To Options</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>Options.ecwWhatChangedJSON</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_What_Changed.json</elementReference></value>
        </assignmentItems>
    </assignments>
    <description>Show a recent deal-motion feed — won, advanced, new, slipped, lost — with net pipeline change this week.</description>
    <environments>Default</environments>
    <interviewLabel>Ecw What Changed {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Agentforce Coworker · Sales · What changed</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector><targetReference>Get_What_Changed</targetReference></connector>
    </start>
    <status>Active</status>
    <variables>
        <description>LLM-provided payload (ignored; data comes from Apex).</description>
        <name>Details</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Show to the user</description>
        <name>Options</name>
        <apexClass>EcwWhatChangedData</apexClass>
        <dataType>Apex</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
