<?xml version="1.0" encoding="UTF-8"?>
<!-- Live data: call invocable Apex EcwNeedsAttention to build the card payload
     from the running user's REAL at-risk open Opportunities, then assign it to
     the DTO output. The LLM-provided `Details` is ignored (kept only to satisfy
     the action signature). -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <actionCalls>
        <name>Get_Needs_Attention</name>
        <label>Get Needs Attention</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <actionName>EcwNeedsAttention</actionName>
        <actionType>apex</actionType>
        <connector><targetReference>Assign_To_Options</targetReference></connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>details</name>
            <value><elementReference>Details</elementReference></value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <assignments>
        <name>Assign_To_Options</name>
        <label>Assign To Options</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>Options.ecwNeedsAttentionJSON</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_Needs_Attention.json</elementReference></value>
        </assignmentItems>
    </assignments>
    <description>Show the running user's open deals that need action — overdue, closing soon, or stalled — ranked by urgency, with total value at risk.</description>
    <environments>Default</environments>
    <interviewLabel>Ecw Needs Attention {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Agentforce Coworker · Sales · Needs attention</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector><targetReference>Get_Needs_Attention</targetReference></connector>
    </start>
    <status>Active</status>
    <variables>
        <description>LLM-provided payload (ignored; data now comes from Apex/SOQL).</description>
        <name>Details</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Show to the user</description>
        <name>Options</name>
        <apexClass>EcwNeedsAttentionData</apexClass>
        <dataType>Apex</dataType>
