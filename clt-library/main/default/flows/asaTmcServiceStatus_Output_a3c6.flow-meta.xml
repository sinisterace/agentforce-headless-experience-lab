<?xml version="1.0" encoding="UTF-8"?>
<!--
  AutoLaunchedFlow action. One assignment: copy the String input `Details`
  into the DTO's JSON field on the `Options` output. No Apex logic. The card
  renders because `Options` is an Apex DTO bound to a CLT in output/schema.json.
  The LLM reads genAiFunctions/.../input/schema.json, NOT this file.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Details_To_Options</name>
        <label>Assign Details To Options</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Options.tmcServiceStatusJSON</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Details</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Show a live service-health board with an overall banner, per-service rows, affected area, and restore ETA.</description>
    <environments>Default</environments>
    <interviewLabel>ASA TMC Service Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ASA Technology, Media &amp; Comms · Service Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Details_To_Options</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>The JSON payload for the card. See the genAiFunction input schema for the exact format.</description>
        <name>Details</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Show to the user</description>
        <name>Options</name>
        <apexClass>AsaTmcServiceStatusData</apexClass>
        <dataType>Apex</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
