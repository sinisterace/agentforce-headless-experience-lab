<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer wants to check the status or progress of an insurance claim they have already filed — for example "where is my claim", "was my claim approved", or "when will I be paid". Shows each claim with a step-by-step progress tracker and the next action needed.</description>
    <invocationTarget>asaInsuranceClaimStatus_Output_c3e9</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Insurance · Claim Status Tracker</masterLabel>
    <progressIndicatorMessage>Checking on your claims</progressIndicatorMessage>
</GenAiFunction>
