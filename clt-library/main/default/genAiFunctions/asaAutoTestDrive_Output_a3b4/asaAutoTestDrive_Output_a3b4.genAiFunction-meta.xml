<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer wants to book, schedule, or set up a test drive for a vehicle. Shows the vehicle, the dealership, selectable days, and available time slots (in showroom or at home), and lets them book one.</description>
    <invocationTarget>asaAutoTestDrive_Output_a3b4</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Automotive · Test Drive Scheduler</masterLabel>
    <progressIndicatorMessage>Finding test drive times</progressIndicatorMessage>
</GenAiFunction>
