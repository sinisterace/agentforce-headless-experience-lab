<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer wants to return, send back, exchange, or get a refund for something they bought. Shows the order's items to select, a reason picker, and refund/exchange/store-credit resolution options.</description>
    <invocationTarget>asaRetailReturns_Output_c4d8</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Retail · Returns &amp; Exchange</masterLabel>
    <progressIndicatorMessage>Starting your return</progressIndicatorMessage>
</GenAiFunction>
