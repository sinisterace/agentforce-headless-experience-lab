<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer wants to send money, pay someone, pay a bill or card, or transfer funds between accounts. Shows an interactive card of recipients and preset amounts; the customer taps a recipient and an amount, then confirms.</description>
    <invocationTarget>asaFinServMoneyMovement_Output_c3e7</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Financial Services · Money Movement</masterLabel>
    <progressIndicatorMessage>Setting up your transfer</progressIndicatorMessage>
</GenAiFunction>
