<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer wants to pick up an item in a store, find a nearby store, check in-store availability, or reserve something for pickup. Shows nearby stores with stock status, distance, pickup ETA, hours, and Directions/Call links; the customer picks a store to reserve.</description>
    <invocationTarget>asaRetailStorePickup_Output_d9e3</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Retail · Store Pickup</masterLabel>
    <progressIndicatorMessage>Finding stores near you</progressIndicatorMessage>
</GenAiFunction>
