<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer needs to choose one or more of their own financial accounts (checking, savings, credit card, loan, investment) — for example to check a balance, pay from, transfer, or start a dispute. Shows an interactive account list with balances.</description>
    <invocationTarget>asaFinServAccountSelector_Output_acc7</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Financial Services · Account Selector</masterLabel>
    <progressIndicatorMessage>Pulling up your accounts</progressIndicatorMessage>
</GenAiFunction>
