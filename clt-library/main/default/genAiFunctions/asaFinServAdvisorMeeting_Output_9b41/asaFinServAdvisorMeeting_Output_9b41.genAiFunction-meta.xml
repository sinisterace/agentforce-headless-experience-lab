<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer wants to schedule, book, or set up a meeting or appointment with their financial advisor. Shows the matched advisor and interactive day/time slots; the customer taps a slot and confirms to request the appointment.</description>
    <invocationTarget>asaFinServAdvisorMeeting_Output_9b41</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Financial Services · Advisor Appointment</masterLabel>
    <progressIndicatorMessage>Finding times with your advisor</progressIndicatorMessage>
</GenAiFunction>
