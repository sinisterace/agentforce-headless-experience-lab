<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer asks about their energy usage, how much they have used this cycle, their projected bill, or why their usage changed. Shows a usage card with a daily/weekly column chart, a projected bill amount, the change vs last month, and a cost breakdown by category.</description>
    <invocationTarget>asaEnergyUsageCost_Output_b8c4</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Energy &amp; Utilities · Usage &amp; Cost</masterLabel>
    <progressIndicatorMessage>Pulling your energy usage</progressIndicatorMessage>
</GenAiFunction>
