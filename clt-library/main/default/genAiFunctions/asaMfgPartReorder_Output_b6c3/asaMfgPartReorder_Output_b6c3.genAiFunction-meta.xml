<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer wants to reorder or buy more of a specific spare part or component, check its stock/lead time, or set a reorder quantity. Shows a single part card with its photo, stock level, lead time, unit price, a quantity stepper, and a reorder action.</description>
    <invocationTarget>asaMfgPartReorder_Output_b6c3</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Manufacturing · Part Reorder</masterLabel>
    <progressIndicatorMessage>Looking up the part</progressIndicatorMessage>
</GenAiFunction>
