<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer reports a power outage, asks if the power is out in their area, or wants to know when service will be restored. Shows an outage card with the cause, number of customers affected, crew status, a restoration progress track, and an estimated restore time.</description>
    <invocationTarget>asaEnergyOutageTracker_Output_a7f3</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Energy &amp; Utilities · Outage Tracker</masterLabel>
    <progressIndicatorMessage>Checking your outage status</progressIndicatorMessage>
</GenAiFunction>
