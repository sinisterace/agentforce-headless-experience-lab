<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer wants to build, configure, or price a vehicle — choosing paint color, trim, drivetrain, or option packages. Shows a build-and-price configurator with color swatches and option groups (each with its price delta), a live estimated price, and a reserve action.</description>
    <invocationTarget>asaAutoConfigurator_Output_e1f2</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Automotive · Vehicle Configurator</masterLabel>
    <progressIndicatorMessage>Building your configuration</progressIndicatorMessage>
</GenAiFunction>
