<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the guest wants to see or choose a hotel room — for example "show me available rooms", "what rooms do you have", or "I want to book a room". Shows a set of room cards (bed, size, occupancy, amenities and nightly rate) the guest picks from, plus a Reserve action.</description>
    <invocationTarget>asaTravelRoomSelector_Output_8d4f</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Travel · Room Selector</masterLabel>
    <progressIndicatorMessage>Finding available rooms</progressIndicatorMessage>
</GenAiFunction>
