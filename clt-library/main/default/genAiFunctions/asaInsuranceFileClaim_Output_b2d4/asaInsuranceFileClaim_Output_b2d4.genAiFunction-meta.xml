<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer wants to start or file an insurance claim and needs to say what happened — for example a car accident, storm or water damage, theft, or a broken window. Shows an interactive form where the customer picks the type of incident for a specific policy.</description>
    <invocationTarget>asaInsuranceFileClaim_Output_b2d4</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Insurance · File a Claim</masterLabel>
    <progressIndicatorMessage>Opening a new claim</progressIndicatorMessage>
</GenAiFunction>
