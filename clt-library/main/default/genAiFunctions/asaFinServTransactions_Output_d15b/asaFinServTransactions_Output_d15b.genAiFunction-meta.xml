<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer wants to see their recent transactions or wants to dispute, question, or report a charge. Shows an interactive list of recent transactions; the customer taps one and confirms to start a dispute.</description>
    <invocationTarget>asaFinServTransactions_Output_d15b</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Financial Services · Recent Transactions</masterLabel>
    <progressIndicatorMessage>Pulling up your recent transactions</progressIndicatorMessage>
</GenAiFunction>
