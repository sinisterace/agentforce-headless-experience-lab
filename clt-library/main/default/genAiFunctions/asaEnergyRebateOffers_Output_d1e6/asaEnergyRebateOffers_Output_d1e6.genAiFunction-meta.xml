<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer asks about rebates, incentives, or ways to save on energy-efficient upgrades (smart thermostat, heat pump, EV charger, insulation, solar). Shows voucher tiles for the rebates they qualify for, each with its rebate amount, and lets them apply for one.</description>
    <invocationTarget>asaEnergyRebateOffers_Output_d1e6</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Energy &amp; Utilities · Rebate Offers</masterLabel>
    <progressIndicatorMessage>Finding rebates you qualify for</progressIndicatorMessage>
</GenAiFunction>
