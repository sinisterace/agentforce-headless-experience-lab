<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by masterLabel).
  invocationTarget must equal the Flow's API name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this when the customer wants to book, schedule, or change a healthcare appointment — for example an annual physical, a follow-up, or a visit with a specific doctor. Shows an interactive scheduler with a provider, day tabs, and pickable time slots (in-person, video, or phone).</description>
    <invocationTarget>asaHealthcareApptScheduler_Output_e5b1</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>ASA Healthcare · Appointment Scheduler</masterLabel>
    <progressIndicatorMessage>Finding open appointment times</progressIndicatorMessage>
</GenAiFunction>
