system:
    instructions: |
        You are the Employee Agent, an internal AI teammate that helps employees
        get work done by rendering interactive cards right in the conversation.
        Run the action that matches the employee's request and let the card do the
        talking — keep any accompanying text to one short sentence. If a request is
        outside the actions you have, briefly say what you can help with instead.
        When a finance user wants to approve or hold invoices or POs, route to the
        AP approvals handler, which collects their choice on an interactive card and
        confirms the result.
    messages:
        welcome: "Hi! I can help across Sales, Service, IT, Finance, and HR — pipeline, cases, system status, budgets, headcount, and more, as interactive cards. What do you need?"
        error: "Sorry, it looks like something has gone wrong."

config:
    developer_name: "Employee_Agent"
    agent_label: "Employee Agent"
    description: "Shows employees their work as interactive cards across Sales (pipeline, deals, forecast, what changed), Service (case prep, CSAT, field dispatch, case escalation), IT (system status, known issues, changes, IT requests), Finance (budget vs actual, AP approvals, AR aging, month-end close), and HR (headcount, who's out, open roles, onboarding)."
    agent_type: "AgentforceEmployeeAgent"

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent main:
    label: "Employee Agent"
    description: "Show the employee's own work as an interactive card. Sales: pipeline, deals that need attention, forecast, what changed. Service: case prep (Case 360), CSAT, field dispatch, and case escalation."

    actions:
        ecwSalesPipeline:
            description: "Use this when the employee asks about their sales pipeline, how their quarter is looking, what is closing, or their win rate. Shows a pipeline snapshot card: total open pipeline, a quarter-over-quarter trend, a stage breakdown, and win-rate / closing / avg-deal stats."
            label: "Sales · My pipeline"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ecwSalesPipeline_Output_a1f7"
            target: "flow://ecwSalesPipeline_Output_a1f7"
            inputs:
                "Details": string
                    description: "Not used — the pipeline is retrieved live for the running user. Pass an empty string."
                    label: "Details"
                    is_required: True
                    is_user_input: False
            outputs:
                "Options": object
                    description: "Show to the user."
                    label: "Options"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "c__ecwSalesPipeline"

        ecwNeedsAttention:
            description: "Use this when the employee asks what deals need attention, what is at risk, what is slipping or overdue, or what they should follow up on. Shows a card of open deals that are overdue, closing soon, or stalled, ranked by urgency, with the total value at risk."
            label: "Sales · Needs attention"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ecwNeedsAttention_Output_b2c4"
            target: "flow://ecwNeedsAttention_Output_b2c4"
            inputs:
                "Details": string
                    description: "Not used — the data is retrieved live for the running user. Pass an empty string."
                    label: "Details"
                    is_required: True
                    is_user_input: False
            outputs:
                "Options": object
                    description: "Show to the user."
                    label: "Options"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "c__ecwNeedsAttention"

        ecwForecast:
            description: "Use this when the employee asks about their forecast, their commit, their best case, how much they will make, or whether they will hit the number. Shows a forecast coverage card: committed amount of total forecast split into Closed / Commit / Best case / Pipeline tiers."
            label: "Sales · Forecast"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ecwForecast_Output_c3d5"
            target: "flow://ecwForecast_Output_c3d5"
            inputs:
                "Details": string
                    description: "Not used — the forecast is retrieved live for the running user. Pass an empty string."
                    label: "Details"
                    is_required: True
                    is_user_input: False
            outputs:
                "Options": object
                    description: "Show to the user."
                    label: "Options"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "c__ecwForecast"

        ecwWhatChanged:
