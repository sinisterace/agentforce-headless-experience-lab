subagent ap_approval:
    label: "AP approvals"
    description: "Collects the finance user's approve/hold selection on the interactive AP approvals card and confirms the result."

    reasoning:
        instructions: ->
            | The finance user wants to approve or place on hold invoices or POs.
              Call {!@actions.approveApInvoices} user_input to show the interactive AP
              approvals card so the user can pick invoices and tap Approve or Hold.
              When the card is submitted (an ACTION_CONFIRM message), call
              {!@actions.approveApInvoices} with the submitted selection, then relay the
              returned confirmation to the user in one short sentence. Do not output any
              other text and do not ask for confirmation.

        actions:
            approveApInvoices: @actions.approveApInvoices
                with selection = ...

    actions:
        approveApInvoices:
            description: "Submits the finance user's approve/hold selection for AP invoices or POs and returns a confirmation."
            label: "Finance · Approve AP invoices"
            require_user_confirmation: False
            include_in_progress_indicator: True
            target: "apex://EcwApApprove"
            inputs:
                "selection": object
                    description: "The invoices/POs the user chose to approve or hold."
                    label: "selection"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "c__ecwApApprovalsInput"
            outputs:
                "confirmation": string
                    description: "Confirmation of the approval/hold to relay to the user in one short sentence."
                    label: "confirmation"

subagent field_dispatch:
    label: "Field dispatch"
    description: "Shows the at-risk appointment with ranked candidate technicians on the interactive field dispatch card, collects the dispatcher's reassignment, and confirms the result."

    reasoning:
        instructions: ->
            | The dispatcher wants to reassign an at-risk service appointment to a
              better technician. Call {!@actions.reassignDispatch} user_input to show the
              interactive field dispatch card so the dispatcher can pick a technician and
              tap Reassign. When the card is submitted (an ACTION_CONFIRM message), call
              {!@actions.reassignDispatch} with the submitted selection, then relay the
              returned confirmation to the user in one short sentence. Do not output any
              other text and do not ask for confirmation.

        actions:
            reassignDispatch: @actions.reassignDispatch
                with selection = ...

    actions:
        reassignDispatch:
            description: "Submits the dispatcher's technician reassignment for an at-risk service appointment and returns a confirmation."
            label: "Service · Reassign dispatch"
            require_user_confirmation: False
            include_in_progress_indicator: True
            target: "apex://EcwReassignDispatch"
            inputs:
                "selection": object
                    description: "The technician the user chose to reassign the appointment to."
                    label: "selection"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "c__ecwFieldDispatchInput"
            outputs:
                "confirmation": string
                    description: "Confirmation of the reassignment to relay to the user in one short sentence."
                    label: "confirmation"

subagent escalation:
    label: "Escalate case"
    description: "Shows the case escalation summary on the interactive escalation card, collects the agent's escalation, and confirms the result."

    reasoning:
        instructions: ->
            | The support agent wants to escalate a case to the on-call team. Call
              {!@actions.raiseEscalation} user_input to show the interactive escalation
              card so the agent can acknowledge the criteria and tap Escalate. When the
              card is submitted (an ACTION_CONFIRM message), call
              {!@actions.raiseEscalation} with the submitted selection, then relay the
              returned confirmation to the user in one short sentence. Do not output any
              other text and do not ask for confirmation.

        actions:
            raiseEscalation: @actions.raiseEscalation
                with selection = ...

    actions:
        raiseEscalation:
            description: "Submits the agent's case escalation and returns a confirmation."
            label: "Service · Raise escalation"
            require_user_confirmation: False
            include_in_progress_indicator: True
            target: "apex://EcwRaiseEscalation"
            inputs:
                "selection": object
                    description: "The case escalation the user confirmed."
                    label: "selection"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "c__ecwEscalationInput"
            outputs:
                "confirmation": string
                    description: "Confirmation of the escalation to relay to the user in one short sentence."
                    label: "confirmation"
