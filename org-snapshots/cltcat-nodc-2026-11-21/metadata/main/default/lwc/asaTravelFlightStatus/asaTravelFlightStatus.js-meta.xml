<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>ASA Travel · Flight Status Tracker</masterLabel>
    <description>Shows a live flight status card — a plane along the route arc between origin and destination, status pill, gates, terminals and baggage claim, with a get-updates action.</description>
    <targets>
        <target>lightning__AgentforceOutput</target>
        <target>lightning__AgentforceInput</target>
        <target>lightningSnapin__ChatMessage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AgentforceOutput">
            <sourceType name="c__asaTravelFlightStatus"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>