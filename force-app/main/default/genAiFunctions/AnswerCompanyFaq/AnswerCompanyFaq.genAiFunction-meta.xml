<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the AnswerCompanyFaqAction Apex invocable as an Agentforce action.
  Deploying this makes "Answer Company FAQ" appear in Agent Builder's action picker;
  attach it to the General FAQ topic and republish the agent to activate it.
  invocationTarget must equal the Apex class name.
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Answers general questions about the company, its products, services, policies, hours, and how to get help, using the company's curated FAQ knowledge. Use this for any general "about the company" question.</description>
    <invocationTarget>AnswerCompanyFaq</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>Answer Company FAQ</masterLabel>
    <progressIndicatorMessage>Looking that up</progressIndicatorMessage>
</GenAiFunction>
