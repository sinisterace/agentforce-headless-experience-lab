<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the Flow as an Agentforce action. Deploying this makes the action
  appear in Agent Builder's "All Actions" picker (search by <masterLabel>).
  <invocationTarget> must equal the Flow's API name (the .flow file name).
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this to <describe when the agent should call this action and show this card>.</description>
    <invocationTarget><FlowApiName></invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel><Human Readable Card Title></masterLabel>
    <progressIndicatorMessage>Thinking</progressIndicatorMessage>
</GenAiFunction>
